{% set odoo_dir = odoo_dir_prefix ~ item.project_name %}
{% set odoo_domain = item.domain | default('') %}
services:
  db:
    image: pgvector/pgvector:pg18-trixie
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ ansible_facts['hostname'] }}
    container_name: db
    environment:
      - POSTGRES_DB=postgres
      - POSTGRES_PASSWORD=odoo
      - POSTGRES_USER=odoo
      - PGDATA=/var/lib/postgresql/data/pgdata
    volumes:
      - db_data:/var/lib/postgresql/data/pgdata
      - {{ odoo_dir }}/config/postgresql.conf:/etc/postgresql/postgresql.conf
    restart: unless-stopped

  odoo:
    container_name: odoo
    image: odoo:{{ item.version }}
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ ansible_facts['hostname'] }}
      resources:
        limits:
          memory: {{ item.max_memory }}
          cpus: '{{ item.max_cpus }}'
        reservations:
          memory: 300M
          cpus: '0.100'
{% if odoo_domain %}
      labels:
        traefik.enable: "true"
        traefik.swarm.network: {{ traefik_swarm_network | to_json }}
        traefik.http.routers.{{ item.project_name }}-web.rule: {{ ('Host(`' ~ odoo_domain ~ '`)') | to_json }}
        traefik.http.routers.{{ item.project_name }}-web.entrypoints: websecure
        traefik.http.routers.{{ item.project_name }}-web.service: {{ item.project_name }}-web
        traefik.http.services.{{ item.project_name }}-web.loadbalancer.server.port: "8069"
        traefik.http.routers.{{ item.project_name }}-ws.rule: {{ ('Host(`' ~ odoo_domain ~ '`) && (Path(`/websocket`) || PathPrefix(`/websocket/`))') | to_json }}
        traefik.http.routers.{{ item.project_name }}-ws.entrypoints: websecure
        traefik.http.routers.{{ item.project_name }}-ws.priority: "100"
        traefik.http.routers.{{ item.project_name }}-ws.service: {{ item.project_name }}-ws
        traefik.http.services.{{ item.project_name }}-ws.loadbalancer.server.port: "8072"
{% endif %}
{% if odoo_domain %}
    networks:
      - default
      - proxy
{% else %}
    ports:
      - target: 8069
        protocol: tcp
        mode: ingress
{% endif %}
    volumes:
      - {{ odoo_dir }}/config:/etc/odoo
      - odoo_data:/var/lib/odoo
{% for repo in item.repos %}
      - {{ odoo_dir }}/{{ repo.name }}:/mnt/{{ repo.name }}
{% endfor %}
    environment:
      # Postgres container name
      - HOST=db
      # Postgres user
      - USER=odoo
      # Postgres password
      - PASSWORD=odoo
      - DB_TEMPLATE=template0
    depends_on:
      - db
    restart: unless-stopped

volumes:
  odoo_data:
    name: odoo_data
    external: ${VOLUME_EXTERNAL:-false}
  db_data:
    name: db_data
    external: ${VOLUME_EXTERNAL:-false}
{% if odoo_domain %}
networks:
  default: {}
  proxy:
    name: {{ traefik_swarm_network | to_json }}
    external: true
{% endif %}

