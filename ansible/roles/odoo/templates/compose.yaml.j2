services:
  db:
    image: pgvector/pgvector:pg18-trixie
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ ansible_facts['hostname'] }}
    container_name: db
    environment:
      - POSTGRES_DB=postgres
      - POSTGRES_PASSWORD=odoo
      - POSTGRES_USER=odoo
      - PGDATA=/var/lib/postgresql/data/pgdata
    volumes:
      - db_data:/var/lib/postgresql/data/pgdata
      - {{item.odoo_dir}}/config/postgresql.conf:/etc/postgresql/postgresql.conf
    restart: unless-stopped

  odoo:
    container_name: odoo
    image: odoo:${ODOO_VERSION:-19}
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ ansible_facts['hostname'] }}
      resources:
        limits:
          memory: {{ item.max_memory }}
          cpus: '{{ item.max_cpus }}'
        reservations:
          memory: 300M
          cpus: '0.100'
    ports:
      - target: 8069
        published: ${ODOO_EXPOSED_PORT:-8069}
        protocol: tcp
        mode: ingress
    volumes:
      - {{item.odoo_dir}}/config:/etc/odoo
      - odoo_data:/var/lib/odoo
{% for repo in item.repos %}
      - {{ item.odoo_dir }}/{{ repo.name }}:/mnt/{{ repo.name }}
{% endfor %}
    environment:
      # Postgres container name
      - HOST=db
      # Postgres user
      - USER=odoo
      # Postgres password
      - PASSWORD=odoo
      - DB_TEMPLATE=template0
    depends_on:
      - db
    restart: unless-stopped

volumes:
  odoo_data:
    name: odoo_data
    external: ${VOLUME_EXTERNAL:-false}
  db_data:
    name: db_data
    external: ${VOLUME_EXTERNAL:-false}

