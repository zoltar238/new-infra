[options]
dbfilter = .*
addons_path = {{ (['/usr/lib/python3/dist-packages/odoo/addons'] + (item.repos | map(attribute='name') | map('regex_replace', '^', '/mnt/') | list)) | join(',') }}
log-db = False
syslog = False
data_dir = /var/lib/odoo
workers = 2
gevent_port = 8072
proxy_mode = True
max_cron_threads = 1
limit_time_cpu = 600
limit_time_real = 1200
