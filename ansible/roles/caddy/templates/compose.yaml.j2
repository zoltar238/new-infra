version: "3.8"
services:
  caddy:
    image: {{ caddy_image | to_json }}
{% if caddy_swarm_network %}
    networks:
      - upstreams
{% endif %}
    # Updating the Caddyfile changes the task spec so Swarm starts Caddy with the new config.
    labels:
      caddy.config-checksum: "{{ caddyfile_content | hash('sha256') }}"
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ hostvars[inventory_hostname].ansible_facts['nodename'] }}
    ports:
      - target: 80
        published: 80
        protocol: tcp
        mode: host
      - target: 443
        published: 443
        protocol: tcp
        mode: host
      - target: 443
        published: 443
        protocol: udp
        mode: host
    volumes:
      - {{ (caddy_dir ~ '/conf:/etc/caddy:ro') | to_json }}
      - {{ (caddy_dir ~ '/site:/srv:ro') | to_json }}
      - caddy_data:/data
      - caddy_config:/config
volumes:
  caddy_data:
  caddy_config:
{% if caddy_swarm_network %}
networks:
  upstreams:
    name: {{ caddy_swarm_network | to_json }}
    external: true
{% endif %}
