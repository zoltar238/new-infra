resource "hcloud_firewall" "firewall" {
  name = "web-and-ssh-only"

  # SSH
  rule {
    direction = "in"
    protocol  = "tcp"
    port      = "22"
    source_ips = [
      "88.1.198.201/32",
      "85.62.67.109/32",
      "188.26.197.82/32",
      "188.26.218.97/32",
      "188.26.218.84/32",
      "81.43.70.177/32",
      "77.211.4.160/32",
    ]
  }

  # HTTP
  rule {
    direction = "in"
    protocol  = "tcp"
    port      = "80"
    source_ips = [
      "88.1.198.201/32",
      "85.62.67.109/32",
      "188.26.197.82/32",
      "188.26.218.97/32",
      "188.26.218.84/32",
      "81.43.70.177/32",
      "77.211.4.160/32",
    ]
  }

  # HTTPS
  rule {
    direction = "in"
    protocol  = "tcp"
    port      = "443"
    source_ips = [
      "88.1.198.201/32",
      "85.62.67.109/32",
      "188.26.197.82/32",
      "188.26.218.97/32",
      "188.26.218.84/32",
